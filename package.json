  "react-native": {
    "platforms": {
      "android": {
        "package": "com.rentbudy.app",
        "versionCode": 1,
        "versionName": "1.0.0",
        "minSdkVersion": 21,
        "targetSdkVersion": 33,
        "compileSdkVersion": 33
      },
      "ios": {
        "bundleIdentifier": "com.rentbudy.app",
